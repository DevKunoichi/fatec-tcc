# ==============================================================================
# Cinemax - Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as suas chaves e segredos locais.
# O arquivo .env NUNCA é versionado no Git por conter dados sensíveis.
# ==============================================================================

# Chave de API da OMDb (Obtenha uma gratuita em https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=sua_chave_omdb_aqui

# Segredo JWT (Opcional em desenvolvimento, recomendado alterar em produção)
JWT_SECRET=dev-secret-cinemax-trocar-em-producao-2026-32chars
